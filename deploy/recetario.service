[Unit]
Description=Recetario (Python sin Docker)
After=network.target

[Service]
Type=simple
# Sustituye usuario y rutas antes de instalar.
User=pi
WorkingDirectory=/home/pi/recetario
EnvironmentFile=/home/pi/.config/recetario/recetario.env
ExecStart=/home/pi/recetario/script.sh start
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
UMask=0077
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
